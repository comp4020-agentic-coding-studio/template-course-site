---
import { getPublishedCollection } from "astro-course-anu/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort((a, b) => (a.data.week ?? 99) - (b.data.week ?? 99));
---

<CardGrid columns={2}>
  {
    visible.map((lecture) => (
      <Card headingLevel="h2" title={lecture.data.title} href={`/lectures/${lecture.id}/`}>
        {lecture.data.description && <p>{lecture.data.description}</p>}
        {lecture.data.week != null && (
          <p>
            <small>Week {lecture.data.week}</small>
          </p>
        )}
      </Card>
    ))
  }
</CardGrid>
