---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-anu/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const people = await getPublishedCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);

// Map the role enum (convenor|tutor|guest|other) to display labels rather than
// rendering the raw lowercase value.
const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};
const roleLabel = person.data.role ? roleLabels[person.data.role] : undefined;
// photoAlt rides the schema's passthrough (definePeopleCollection has no
// extension point), so it needs a cast out of the generated types.
const rawPhotoAlt = (person.data as { photoAlt?: unknown }).photoAlt;
const photoAlt = typeof rawPhotoAlt === "string" ? rawPhotoAlt : "";
// Every page owes a description --- it is what a search result and a shared
// link show underneath the title. The people schema has no field for one, so
// compose it from what a person entry does carry.
const description =
  [roleLabel, person.data.affiliation].filter(Boolean).join(", ") || person.data.title;
---

<ContentLayout
  title={person.data.title}
  description={description}
  heroImage={person.data.photo ?? undefined}
  heroImageAlt={photoAlt}
  {...siteConfig}
>
  <dl>
    {roleLabel && (
      <>
        <dt>Role</dt>
        <dd>{roleLabel}</dd>
      </>
    )}
    {person.data.affiliation && (
      <>
        <dt>Affiliation</dt>
        <dd>{person.data.affiliation}</dd>
      </>
    )}
    {person.data.email && (
      <>
        <dt>Email</dt>
        <dd>
          <a href={`mailto:${person.data.email}`}>{person.data.email}</a>
        </dd>
      </>
    )}
    {person.data.url && (
      <>
        <dt>Web</dt>
        <dd>
          <a href={person.data.url}>{person.data.url}</a>
        </dd>
      </>
    )}
  </dl>

  <Content />
</ContentLayout>
